NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/unique_youths?retryWrites=true&w=majority
# Optional override - the code always uses this regardless of whether the
# URI above happens to include a database name in its path. Only change
# this if you actually want a different database name than the default.
MONGODB_DB_NAME=unique_youths
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=Unique Youths <no-reply@yourdomain.com>

# SMS OTP (optional alternative to email, opt-in per member at registration).
# Costs money per message via Termii - leave unset and the SMS choice just
# won't be offered on the registration form. Get these from your Termii
# dashboard at accounts.termii.com; TERMII_SENDER_ID must be an
# approved/registered sender ID on your account.
TERMII_API_KEY=
TERMII_SENDER_ID=
REGISTRATION_TOKEN_EXPIRES_IN=45m
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
CIRCLE_BASELINE_SIZE=20
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_INITIAL_PASSWORD=replace-with-12+-char-password
SUPERVISOR_EMAIL=supervisor@example.com
SUPERVISOR_USERNAME=supervisor
SUPERVISOR_INITIAL_PASSWORD=replace-with-12+-char-password

# Free database backup - dumps core collections to JSON and emails them via
# Resend. BACKUP_EMAIL_TO defaults to SUPER_ADMIN_EMAIL if unset. BACKUP_SECRET
# lets a scheduled GitHub Action trigger this without an admin login session -
# generate any long random string and put the same value in the repo's
# GitHub secret of the same name.
BACKUP_EMAIL_TO=
BACKUP_SECRET=
